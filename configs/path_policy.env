PACK_DIR="${PACK_DIR:-$(pwd)}"
WORKSPACE_DIR="${WORKSPACE_DIR:-$PACK_DIR/.workspace}"
NANOCHAT_DIR="${NANOCHAT_DIR:-$WORKSPACE_DIR/nanochat}"
NANOCHAT_BASE_DIR="${NANOCHAT_BASE_DIR:-$WORKSPACE_DIR/nanochat_base}"
LOCAL_TEXT_DIR="${LOCAL_TEXT_DIR:-$PACK_DIR/data_input/be_texts}"
DOWNLOAD_DIR="${DOWNLOAD_DIR:-$PACK_DIR/data_input/downloads}"
REPORT_DIR="${REPORT_DIR:-$PACK_DIR/reports}"
DIST_DIR="${DIST_DIR:-$PACK_DIR/dist}"
TMPDIR="${TMPDIR:-$WORKSPACE_DIR/tmp}"
XDG_CACHE_HOME="${XDG_CACHE_HOME:-$WORKSPACE_DIR/xdg_cache}"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$WORKSPACE_DIR/xdg_config}"
HF_HOME="${HF_HOME:-$WORKSPACE_DIR/hf_home}"
TORCH_HOME="${TORCH_HOME:-$WORKSPACE_DIR/torch_home}"
PIP_CACHE_DIR="${PIP_CACHE_DIR:-$WORKSPACE_DIR/pip_cache}"
UV_CACHE_DIR="${UV_CACHE_DIR:-$WORKSPACE_DIR/uv_cache}"
WANDB_DIR="${WANDB_DIR:-$WORKSPACE_DIR/wandb}"
CARGO_HOME="${CARGO_HOME:-$WORKSPACE_DIR/cargo}"
RUSTUP_HOME="${RUSTUP_HOME:-$WORKSPACE_DIR/rustup}"
# Auto-detect compute dtype (bf16 on Ampere+/Hopper incl. H200; fp16 opt-in below).
# Set NANOCHAT_DTYPE=float16 to force the legacy RTX 3070 Ti profile.
NANOCHAT_DTYPE="${NANOCHAT_DTYPE:-}"
WANDB_MODE="${WANDB_MODE:-disabled}"
WANDB_DISABLED="${WANDB_DISABLED:-true}"
WANDB_SILENT="${WANDB_SILENT:-true}"
PYTHONNOUSERSITE="${PYTHONNOUSERSITE:-1}"
