# Copy to .env or source it before running scripts.
# NOTE: All paths are repo-contained. Source ops/local/pack_paths.sh instead of hardcoding.
export PACK_DIR="$PWD"
# NANOCHAT_DIR, NANOCHAT_BASE_DIR, LOCAL_TEXT_DIR are auto-set by ops/local/pack_paths.sh
# Override only if you need a custom location INSIDE PACK_DIR:
# export NANOCHAT_DIR="$PACK_DIR/.workspace/nanochat"
# export NANOCHAT_BASE_DIR="$PACK_DIR/.workspace/nanochat_base"
# export LOCAL_TEXT_DIR="$PACK_DIR/data_input/be_texts"
export NANOCHAT_DTYPE="float16"
export WANDB_MODE="disabled"
export WANDB_DISABLED="true"
export WANDB_SILENT="true"
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
# Optional Hugging Face publishing
export HF_TOKEN=""
export HF_REPO_ID="username/belarusian-nanochat"
